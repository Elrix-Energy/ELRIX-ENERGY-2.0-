# ─────────────────────────────────────────────────────────────────────────────
# ELRIX ENERGY — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical root URL — use apex domain only (no www, no trailing slash).
# Example: https://elrixenergy.com  (NOT https://www.elrixenergy.com)
NEXT_PUBLIC_SITE_URL=https://elrixenergy.com

# ── Analytics (loaded only after cookie consent) ─────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── Contact form ──────────────────────────────────────────────────────────────
# Submissions post to /api/contact → FormSubmit → CONTACT.email in siteConfig.
# Activate the inbox once at formsubmit.co if this is a new deployment.

# Google reCAPTCHA v3 (required in production — contact form is rejected without both keys)
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Sanity CMS (planned) ─────────────────────────────────────────────────────
# Blog posts, testimonials, trust KPIs, and project case studies.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=
