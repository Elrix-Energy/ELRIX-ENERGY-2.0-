# ─────────────────────────────────────────────────────────────────────────────
# ELRIX ENERGY — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical root URL (no trailing slash). Used for OG images, canonicals, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://elrixenergy.com

# ── Analytics (loaded only after cookie consent) ─────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── Contact form ──────────────────────────────────────────────────────────────
# Submissions use FormSubmit (https://formsubmit.co) to CONTACT.email in siteConfig.
# Activate the inbox once at formsubmit.co if this is a new deployment.

# ── Sanity CMS (planned) ─────────────────────────────────────────────────────
# Blog posts, testimonials, trust KPIs, and project case studies.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=

# ── reCAPTCHA (future) ────────────────────────────────────────────────────────
# Google reCAPTCHA v3 site key (client-side, safe to expose).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# reCAPTCHA secret key (server-side, keep private).
RECAPTCHA_SECRET_KEY=
